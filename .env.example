# 1. Telegram API ma'lumotlari (https://my.telegram.org saytidan olinadi)
API_ID=12345678
API_HASH=sizning_api_hash_kodingiz

# 2. Shaxsiy akkaunt sessiya kodi (generate_session.py orqali olinadi)
SESSION_STRING=

# 3. Telegram Boshqaruv Boti tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:AAH_sizning_bot_tokeningiz

# 4. Sun'iy Intellekt API kaliti (https://console.groq.com/keys yoki https://aistudio.google.com/app/apikey)
GROQ_API_KEY=gsk_sizning_groq_kalitingiz
GEMINI_API_KEY=

# 5. Sizning ismingiz
OWNER_NAME=Qadrdon do'stingiz

# 6. Server porti
PORT=8080
DEBOUNCE_SECONDS=1.5
